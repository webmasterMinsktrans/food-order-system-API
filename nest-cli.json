{
  "$schema": "https://schemastore.org",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { 
        "include": "assets/templates/**/*.html", 
        "outDir": "dist",
        "watchAssets": true 
      }
    ],
    "watchAssets": true
  }
}
